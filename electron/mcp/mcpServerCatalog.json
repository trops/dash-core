{
  "version": "1.0.0",
  "servers": [
    {
      "id": "github",
      "name": "GitHub",
      "description": "Access GitHub repositories, issues, pull requests, and more via the GitHub API.",
      "icon": "github",
      "tags": ["developer", "git", "code"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "envMapping": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "token"
        }
      },
      "credentialSchema": {
        "token": {
          "type": "text",
          "displayName": "Personal Access Token",
          "required": false,
          "secret": true,
          "instructions": "Generate a Personal Access Token at github.com/settings/tokens with the required scopes."
        }
      }
    },
    {
      "id": "slack",
      "name": "Slack",
      "description": "Read, search, and send messages across your Slack workspace. Provide ONE of: a bot token (xoxb-), a user OAuth token (xoxp-), or a browser-session pair (xoxc- + xoxd-). The browser-session pair works without workspace admin approval and gives full visibility.",
      "icon": "slack",
      "tags": ["communication", "messaging", "team"],
      "credentialOptions": [
        ["xoxbToken"],
        ["xoxpToken"],
        ["xoxcToken", "xoxdToken"]
      ],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "slack-mcp-server"],
        "envMapping": {
          "SLACK_MCP_XOXB_TOKEN": "xoxbToken",
          "SLACK_MCP_XOXP_TOKEN": "xoxpToken",
          "SLACK_MCP_XOXC_TOKEN": "xoxcToken",
          "SLACK_MCP_XOXD_TOKEN": "xoxdToken"
        },
        "staticEnv": {
          "SLACK_MCP_ADD_MESSAGE_TOOL": "true"
        }
      },
      "credentialSchema": {
        "xoxbToken": {
          "type": "text",
          "displayName": "Bot Token (xoxb-)",
          "required": false,
          "secret": true,
          "instructions": "Optional. Create a Slack app at api.slack.com/apps and install it to your workspace. Bots only see channels they're invited to and can't use search."
        },
        "xoxpToken": {
          "type": "text",
          "displayName": "User OAuth Token (xoxp-)",
          "required": false,
          "secret": true,
          "instructions": "Optional. User token from a Slack app — sees everything your user can see, limited search."
        },
        "xoxcToken": {
          "type": "text",
          "displayName": "Browser Session Token (xoxc-)",
          "required": false,
          "secret": true,
          "instructions": "Optional. From your logged-in Slack browser session (DevTools → Application → Local Storage → localConfig_v2 → teams.<id>.token). Pair with the xoxd cookie below."
        },
        "xoxdToken": {
          "type": "text",
          "displayName": "Browser Session Cookie (xoxd-)",
          "required": false,
          "secret": true,
          "instructions": "Optional. From your Slack browser cookies (DevTools → Application → Cookies → `d` value). Used together with the xoxc token above."
        }
      }
    },
    {
      "id": "notion",
      "name": "Notion",
      "description": "Read and search Notion pages, databases, and comments.",
      "icon": "book",
      "tags": ["productivity", "notes", "wiki"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@notionhq/notion-mcp-server"],
        "envMapping": {
          "OPENAPI_MCP_HEADERS": "authHeader"
        }
      },
      "credentialSchema": {
        "authHeader": {
          "type": "text",
          "displayName": "API Key (as Authorization header JSON)",
          "required": false,
          "secret": true,
          "instructions": "Create an integration at notion.so/my-integrations. Provide as JSON: {\"Authorization\": \"Bearer ntn_...\", \"Notion-Version\": \"2022-06-28\"}"
        }
      }
    },
    {
      "id": "brave-search",
      "name": "Brave Search",
      "description": "Search the web using the Brave Search API.",
      "icon": "search",
      "tags": ["search", "web", "research"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-brave-search"],
        "envMapping": {
          "BRAVE_API_KEY": "apiKey"
        }
      },
      "credentialSchema": {
        "apiKey": {
          "type": "text",
          "displayName": "API Key",
          "required": false,
          "secret": true,
          "instructions": "Get an API key from brave.com/search/api."
        }
      }
    },
    {
      "id": "filesystem",
      "name": "Filesystem",
      "description": "Read, write, and manage files on your local filesystem.",
      "icon": "folder",
      "tags": ["files", "local", "storage"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem"],
        "envMapping": {},
        "argsMapping": {
          "allowedPaths": { "type": "split", "delimiter": "," }
        }
      },
      "credentialSchema": {
        "allowedPaths": {
          "type": "directory-list",
          "displayName": "Allowed Directories",
          "required": true,
          "secret": false,
          "instructions": "Absolute paths this server is permitted to read and write. Use the Choose folder… button — `~` shortcuts are not expanded by the server process."
        }
      }
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "description": "Query and manage PostgreSQL databases.",
      "icon": "database",
      "tags": ["database", "sql", "data"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-postgres"],
        "envMapping": {
          "POSTGRES_CONNECTION_STRING": "connectionString"
        }
      },
      "credentialSchema": {
        "connectionString": {
          "type": "text",
          "displayName": "Connection String",
          "required": false,
          "secret": true,
          "instructions": "PostgreSQL connection string (e.g., postgresql://user:password@localhost:5432/dbname)."
        }
      }
    },
    {
      "id": "linear",
      "name": "Linear",
      "description": "Manage Linear issues, projects, and teams.",
      "icon": "clipboard-list",
      "tags": ["project-management", "issues", "team"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "mcp-linear"],
        "envMapping": {
          "LINEAR_API_KEY": "apiKey"
        }
      },
      "credentialSchema": {
        "apiKey": {
          "type": "text",
          "displayName": "API Key",
          "required": false,
          "secret": true,
          "instructions": "Generate a Personal API Key in Linear Settings > API."
        }
      }
    },
    {
      "id": "memory",
      "name": "Memory",
      "description": "Persistent key-value memory storage using a knowledge graph.",
      "icon": "brain",
      "tags": ["storage", "memory", "knowledge"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-memory"],
        "envMapping": {}
      },
      "credentialSchema": {}
    },
    {
      "id": "google-drive",
      "name": "Google Drive",
      "description": "Search, read, and write files in Google Drive. Supports folder listing, file creation, and path resolution.",
      "icon": "google-drive",
      "tags": ["google", "files", "cloud-storage"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "node",
        "args": ["{{MCP_DIR}}/servers/google-drive.js"],
        "staticEnv": {
          "GDRIVE_CREDENTIALS_PATH": "~/.gdrive-mcp/credentials.json"
        }
      },
      "authCommand": {
        "command": "node",
        "args": ["{{MCP_DIR}}/servers/google-drive.js", "auth"],
        "staticEnv": {
          "GDRIVE_CREDENTIALS_PATH": "~/.gdrive-mcp/credentials.json"
        }
      },
      "credentialSchema": {}
    },
    {
      "id": "gmail",
      "name": "Gmail",
      "description": "Search, read, send, and manage Gmail messages, threads, labels, and drafts.",
      "icon": "envelope",
      "tags": ["google", "email", "communication"],
      "readOnlyTools": [
        "read_email",
        "search_emails",
        "list_email_labels",
        "get_filter",
        "list_filters"
      ],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
        "tokenRefresh": {
          "credentialsPath": "~/.gmail-mcp/credentials.json",
          "oauthKeysPath": "~/.gmail-mcp/gcp-oauth.keys.json"
        }
      },
      "authCommand": {
        "command": "npx",
        "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp", "auth"],
        "setup": {
          "copyCredential": {
            "from": "oauthKeysPath",
            "to": "~/.gmail-mcp/gcp-oauth.keys.json"
          }
        }
      },
      "credentialSchema": {
        "oauthKeysPath": {
          "type": "file",
          "displayName": "OAuth Keys File",
          "required": true,
          "secret": false,
          "instructions": "Path to your Google OAuth keys file (gcp-oauth.keys.json). Enable the Gmail API at console.cloud.google.com, create OAuth 2.0 credentials (Desktop app type), and download the JSON file."
        }
      }
    },
    {
      "id": "google-calendar",
      "name": "Google Calendar",
      "description": "List calendars, create, read, update, and delete events in Google Calendar.",
      "icon": "calendar-alt",
      "tags": ["google", "calendar", "scheduling"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@cocal/google-calendar-mcp"],
        "envMapping": {
          "GOOGLE_OAUTH_CREDENTIALS": "oauthKeysPath"
        }
      },
      "authCommand": {
        "command": "npx",
        "args": ["-y", "@cocal/google-calendar-mcp", "auth"]
      },
      "credentialSchema": {
        "oauthKeysPath": {
          "type": "file",
          "displayName": "OAuth Keys File",
          "required": false,
          "secret": false,
          "instructions": "Path to your Google OAuth keys file (gcp-oauth.keys.json). Enable the Google Calendar API at console.cloud.google.com, then create OAuth 2.0 credentials."
        }
      }
    },
    {
      "id": "algolia",
      "name": "Algolia",
      "description": "Search, browse, and manage Algolia indices via Algolia's hosted MCP endpoint. No local process needed.",
      "icon": "search-plus",
      "tags": ["search", "data", "analytics"],
      "mcpConfig": {
        "transport": "streamable_http",
        "url": "{{url}}",
        "headerTemplate": {
          "Authorization": "Bearer {{apiKey}}"
        }
      },
      "credentialSchema": {
        "url": {
          "type": "text",
          "displayName": "MCP Server URL",
          "required": false,
          "secret": false,
          "instructions": "Your Algolia MCP endpoint URL from the Algolia dashboard (e.g., https://mcp.us.algolia.com/1/abc123/mcp)."
        },
        "apiKey": {
          "type": "text",
          "displayName": "API Key",
          "required": false,
          "secret": true,
          "instructions": "Your Algolia Search API Key, found in the Algolia dashboard under API Keys."
        }
      }
    },
    {
      "id": "gong",
      "name": "Gong",
      "description": "Browse Gong call recordings, transcripts, and AI-generated summaries.",
      "icon": "phone",
      "tags": ["sales", "calls", "transcripts"],
      "mcpConfig": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "gongio-mcp"],
        "envMapping": {
          "GONG_ACCESS_KEY": "accessKey",
          "GONG_ACCESS_KEY_SECRET": "accessKeySecret"
        }
      },
      "credentialSchema": {
        "accessKey": {
          "type": "text",
          "displayName": "Access Key",
          "required": true,
          "secret": true,
          "instructions": "Your Gong API Access Key. Generate one in Gong Settings > Ecosystem > API."
        },
        "accessKeySecret": {
          "type": "text",
          "displayName": "Access Key Secret",
          "required": true,
          "secret": true,
          "instructions": "Your Gong API Access Key Secret, provided when the access key was created."
        }
      }
    },
    {
      "id": "web-fetch",
      "name": "Web Fetch",
      "description": "Download images and web pages from HTTPS sites so bots can see and read them. Built into Dash — nothing to install. Only reaches public websites.",
      "icon": "globe",
      "tags": ["web", "images", "built-in"],
      "mcpConfig": {
        "transport": "in_process",
        "builtin": "web-fetch"
      },
      "credentialSchema": {
        "maxDownloadMb": {
          "type": "number",
          "displayName": "Max download size",
          "required": false,
          "secret": false,
          "default": 10,
          "min": 1,
          "max": 50,
          "unit": "MB",
          "instructions": "Largest file Web Fetch will download."
        },
        "timeoutSeconds": {
          "type": "number",
          "displayName": "Timeout",
          "required": false,
          "secret": false,
          "default": 20,
          "min": 5,
          "max": 120,
          "unit": "seconds",
          "instructions": "How long to wait for a site before giving up."
        },
        "maxImages": {
          "type": "number",
          "displayName": "Max images per result",
          "required": false,
          "secret": false,
          "default": 5,
          "min": 1,
          "max": 20,
          "instructions": "Most images one fetch_image call returns when given several URLs."
        },
        "allowedSites": {
          "type": "text-list",
          "displayName": "Allowed sites",
          "required": false,
          "secret": false,
          "placeholder": "cdn.example.com or *.example.com",
          "instructions": "Leave empty to allow any public website. *.example.com matches its subdomains."
        },
        "shrinkLargeImages": {
          "type": "toggle",
          "displayName": "Shrink large images",
          "required": false,
          "secret": false,
          "default": true,
          "instructions": "Shrink PNG and JPEG images that are too big for the model. When off, they're refused with an error."
        }
      }
    }
  ]
}
